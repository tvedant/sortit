# Copy this file to .env and fill in real values before running.
# Never commit your actual .env file to a public repo.

PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# --- Staff workspace (/admin) ---
# Change these before deploying — the defaults are NOT secure.
ADMIN_USER=admin
ADMIN_PASS=changeme123

# --- Customer login sessions ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# --- Case filing fee ---
# Amount in paise (₹59.00 = 5900). Change this to adjust the fee shown on site.
CASE_FEE_PAISE=5900

# --- Razorpay (leave blank to run in TEST MODE with simulated payments) ---
# Get these from your Razorpay dashboard once you're ready to accept real payments:
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI lead capture (legacy; homepage chat is no longer used) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Sign-In (public OAuth client ID)
GOOGLE_CLIENT_ID=
